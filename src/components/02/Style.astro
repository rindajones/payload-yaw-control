<style is:global>
  :root {
    --text-width: 760px;
    --section-space: 88px;
    --text-color: #252525;
    --muted-color: #6b7280;
    --link-color: #2563a6;
    --border-color: #d9dde3;
    --surface-color: #ffffff;
    --soft-surface-color: #f5f7fa;
    --page-gutter: clamp(40px, 8vw, 160px);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--text-color);
    background: var(--surface-color);
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP",
      "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
    font-size: 16px;
    line-height: 1.85;
  }

  img,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--link-color);
  }
<!--
  .part02-main {
    width: calc(100% - 160px);
    margin: 0 auto;
    padding: 32px 0 0;
  } 
-->
  .part02-main,
  .part02-header-inner,
  .part02-footer-inner {
    width: calc(100% - var(--page-gutter));
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: 56px;
    text-align: center;
  }

  .page-title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.3;
    font-weight: 700;
  }

  .page-lead {
    max-width: var(--text-width);
    margin: 24px auto 0;
    color: var(--muted-color);
    font-size: 1.08rem;
    line-height: 1.8;
    text-align: left;
  }

  .content-section {
    margin-top: var(--section-space);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .content-section:first-child {
    margin-top: 0;
  }

  .section-title {
    margin: 0 0 28px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.35;
  }

  .text-block {
    max-width: var(--text-width);
  }

  .text-block.center {
    margin-inline: auto;
  }

  .two-column {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    align-items: start;
  }

  .three-column {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  .figure {
    margin: 0;
  }

  .figure img {
    width: 100%;
    border: 1px solid var(--border-color);
  }

  .figure figcaption {
    margin-top: 10px;
    color: var(--muted-color);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  .card {
    height: 100%;
    padding: 24px;
    background: var(--soft-surface-color);
    border: 1px solid var(--border-color);
  }

  .card h3 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  .note {
    padding: 18px 22px;
    background: var(--soft-surface-color);
    border-left: 4px solid var(--link-color);
  }

  .note p {
    margin: 0;
  }

  @media (max-width: 760px) {
    :root {
      --section-space: 64px;
    }

    .part02-main {
      padding-top: 44px;
    }

    .page-header {
      margin-bottom: 44px;
      text-align: left;
    }

    .page-lead {
      margin-left: 0;
    }

    .two-column,
    .three-column {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
