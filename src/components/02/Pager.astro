---
interface NavItem {
  title: string;
  href: string;
}

interface Props {
  prev?: NavItem;
  next?: NavItem;
}

const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;

const withBase = (href: string) =>
  `${base}/${href.replace(/^\/+/, "")}`;  
---

<div class="part02-pager">
  <div class="part02-pager-inner">
    <p>Payload Yaw Control — Part 2</p>

    <nav aria-label="Page navigation">
      {prev && <a href={withBase(prev.href)}>{prev.title}</a>}
      {prev && next && <span aria-hidden="true">/</span>}
      {next && <a href={withBase(next.href)}>{next.title}</a>}
    </nav>
  </div>
</div>

<style>
  .part02-pager {
    margin-top: 24px;
    color: var(--muted-color);
  }

  .part02-pager-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    width: calc(100% - var(--page-gutter));
    margin-inline: auto;
    padding-block: 24px;
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  a {
    color: var(--link-color);
    text-decoration: none;
    font-size: 1.05rem;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .part02-pager-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>