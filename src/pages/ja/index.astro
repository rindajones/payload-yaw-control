x---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const title = "吊り荷 Yaw 制御システムの開発";
const description =
  "強化学習と画像姿勢推定による吊り荷Yaw制御システムの開発記録";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" href={`${base}favicon.ico`} />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <nav class="project-nav">
      <!-- <a href="#part02">Part 2</a> -->
      <a href={`${base}ja/overview`}>Part 1</a>
      Part 2
      <a href={`${base}ja/contact`}>お問い合わせ</a>
      <a href={`${base}en/`}>English</a>
    </nav>

    <main>
      <section class="hero">
        <p class="hero-subtitle">
          強化学習・画像姿勢推定・Raspberry Piによる実証
        </p>

        <h1>吊り荷 Yaw 制御システムの開発</h1>

        <p class="hero-text">
          画像による姿勢推定と強化学習によるスラスター制御を組み合わせ、<br />
          吊り荷のYaw角を自動制御するシステムを開発しています。
        </p>
      </section>

      <section class="part-links">
        <article>
          <p class="part-label">Part 2 — Latest</p>
          <h2>低出力・可変目標Yaw制御</h2>
          <p>
            3種類の吊り荷を対象に、0°、±45°、±90°への低出力制御を評価します。
          </p>

          <a href="#part02">概要へ</a>
          <!-- <a href={`${base}ja/part02/`}>詳細を見る</a> -->
        </article>

        <article>
          <p class="part-label">Part 1</p>
          <h2>画像ベース吊り荷Yaw制御</h2>
          <p>
            画像からYaw角を推定し、Raspberry Pi上で制御モデルを実行する
            基本システムを構築しました。
          </p>

          <a href="#part01">概要へ</a>
          <a href={`${base}ja/overview`}>詳細を見る</a>
        </article>
      </section>

      <section id="part02" class="part-summary">
        <h2>Part 2　概要</h2>
        <p>
          単一モデルによる可変目標Yaw角への対応と、
          不要なスラスター出力を抑えた低出力制御を扱います。
        </p>
        <video controls muted playsinline preload="metadata">
          <source
            src={`${base}videos/Part02/HSteel_0001-1900.mp4`}
            type="video/mp4"
          />
        </video>
      </section>

      <section id="part01" class="part-summary">
        <h2>Part 1　概要</h2>
        <p>
          画像によるYaw角推定から、Raspberry Pi上でのリアルタイム制御までを
          検証した基本システムです。
        </p>
        <video controls muted playsinline preload="metadata">
          <source
            src={`${base}videos/With_Without_Control-Raspberry_Pi.mp4`}
            type="video/mp4"
          />
        </video>
      </section>
    </main>

    <Footer lang="ja" />
  </body>
</html>

<style>
  .project-nav {
    display: flex;
    justify-content: center;
    gap: 32px;
    padding: 18px;
    border-bottom: 1px solid #ddd;
  }

  main {
    width: min(100% - 40px, 960px);
    margin: 0 auto;
  }

  .hero {
    padding: 80px 0;
    text-align: center;
  }

  .hero-subtitle,
  .part-label {
    color: #666;
  }

  .hero-text {
    max-width: 720px;
    margin: 24px auto 0;
    line-height: 1.8;
  }

  .part-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .part-links article {
    padding: 24px;
    border: 1px solid #ddd;
  }

  .part-links a {
    display: inline-block;
    margin: 12px 18px 0 0;
  }

  .part-summary {
    padding: 72px 0;
    border-top: 1px solid #ddd;
    scroll-margin-top: 24px;
  }

  video {
    width: 100%;
    margin-top: 24px;
  }

  @media (max-width: 700px) {
    .part-links {
      grid-template-columns: 1fr;
    }
  }
</style>